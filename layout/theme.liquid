<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  data-motion="{% if settings.enable_motion == false %}false{% else %}true{% endif %}"
  data-respect-reduced-motion="{% if settings.respect_reduced_motion == false %}false{% else %}true{% endif %}"
  data-icon-style="{{ settings.icon_style | default: 'outline' }}"
>
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'variant-picker.js' | asset_url }}" defer></script>

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% if settings.favicon != blank %}
      {{ settings.favicon | image_url: width: 48 | image_tag: rel: 'icon' }}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
