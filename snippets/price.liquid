{% doc %}
  Renders a product price using the global Prices settings.

  @param {product} product - Product whose price should be rendered
{% enddoc %}

{% if settings.price_show_currency_code %}
  <span>{{ product.price | money_with_currency }}</span>
{% else %}
  <span>{{ product.price | money }}</span>
{% endif %}
{% if settings.price_show_compare_at and product.compare_at_price > product.price %}
  {% if settings.price_show_currency_code %}
    <s>{{ product.compare_at_price | money_with_currency }}</s>
  {% else %}
    <s>{{ product.compare_at_price | money }}</s>
  {% endif %}
{% endif %}
