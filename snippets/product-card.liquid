{% doc %}
  Renders a reusable product card for collection, search, and recommendation grids.

  @param {product} product - Product to render
{% enddoc %}

{% liquid
  assign card_scheme = settings.product_card_color_scheme | default: 'scheme-1'
  assign card_style = settings.product_card_style | default: 'standard'
  assign card_ratio = settings.product_card_image_ratio | default: 'original'
  assign selected_variant = product.selected_or_first_available_variant
  assign title_limit = settings.product_card_title_line_limit | default: 'none'
  assign card_swatch_type = settings.product_card_swatch_type | default: 'inherit'
  if card_swatch_type == 'inherit'
    assign card_swatch_type = settings.swatch_style | default: 'color'
  endif
  assign quick_add_scheme = settings.product_card_quick_add_color_scheme | default: 'scheme-1'
  assign quick_add_scheme_number = quick_add_scheme.id | default: quick_add_scheme | remove: 'scheme-' | remove: 'scheme_'
%}

<article class="product-card product-card--{{ card_style }} {{ card_scheme }}" data-product-card>
  <div class="product-card__media{% if card_ratio != 'original' %} product-card__media--{{ card_ratio }}{% endif %}">
    <a class="product-card__media-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 900 | image_tag: class: 'product-card__image', loading: 'lazy' }}
        {% if settings.product_card_show_secondary_image and product.images[1] %}
          {{ product.images[1] | image_url: width: 900 | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy' }}
        {% endif %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' }}
      {% endif %}
    </a>

    {% render 'product-badges', product: product %}

    {% if settings.product_card_enable_quick_add and selected_variant.available %}
      <form class="product-card__quick-add scheme-{{ quick_add_scheme_number }}" action="{{ routes.cart_add_url }}" method="post" data-quick-add>
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <button class="btn btn--primary{% if settings.product_card_quick_add_full_width %} product-card__quick-add-button--full{% endif %}" type="submit">
          {% if settings.product_card_quick_add_desktop_style == 'icon' %}<span aria-hidden="true">+</span><span class="visually-hidden">Add {{ product.title | escape }} to cart</span>{% else %}Add to cart{% endif %}
        </button>
      </form>
    {% endif %}

    {% if settings.product_card_enable_quick_view %}
      <a class="product-card__quick-view btn btn--tertiary" href="{{ product.url }}" data-quick-view>Quick view</a>
    {% endif %}
  </div>

  <div class="product-card__content">
    {% if settings.product_card_show_swatches and product.options_with_values.first.values.size > 0 %}
      <div class="product-card__swatches product-card__swatches--{{ settings.product_card_swatch_position | default: 'bottom' }}" aria-label="{{ product.options_with_values.first.name | escape }}">
        {% for option_value in product.options_with_values.first.values limit: settings.product_card_swatch_limit %}
          {% assign swatch_variant = blank %}
          {% for variant in product.variants %}
            {% if variant.option1 == option_value %}{% assign swatch_variant = variant %}{% break %}{% endif %}
          {% endfor %}
          <a class="product-card__swatch{% if option_value == selected_variant.option1 %} is-selected{% endif %}" href="{{ swatch_variant.url | default: product.url }}" aria-label="{{ option_value | escape }}"{% if card_swatch_type == 'variant_image' and swatch_variant.featured_image %} style="background-image: url('{{ swatch_variant.featured_image | image_url: width: 80 }}')"{% else %} style="background-color: {{ option_value | downcase | escape }}"{% endif %}></a>
        {% endfor %}
      </div>
    {% endif %}

    <div class="product-card__details">
      {% if settings.product_card_show_vendor %}<p class="product-card__vendor">{{ product.vendor | escape }}</p>{% endif %}
      {% if settings.product_card_show_type and product.type != blank %}<p class="product-card__type">{{ product.type | escape }}</p>{% endif %}
      <h3 class="product-card__title{% if title_limit != 'none' %} product-card__title--limit-{{ title_limit }}{% endif %}"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      <div class="product-card__price{% if product.compare_at_price > product.price %} product-card__price--sale{% endif %}">
        {% render 'price', product: product, variant: selected_variant, context: 'product_card' %}
      </div>
    </div>
  </div>
</article>
