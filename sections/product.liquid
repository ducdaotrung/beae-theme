{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    <div class="product-image" data-product-media="{{ image.id }}">
      {{ image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
    </div>
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  <p>{{ product.description }}</p>
</div>

<div class="product-form">
  {% form 'product', product %}
    {% render 'variant-picker', product: product %}

    <input class="form__control" type="text" name="quantity" min="1" value="1">

    <input class="btn btn--primary" type="submit" value="Add to cart">
    {{ form | payment_button }}
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
