{% assign header_scheme = section.settings.color_scheme | default: settings.color_schemes.first %}
{% assign header_scheme_number = header_scheme.id | remove: 'scheme-' | remove: 'scheme_' %}

<header class="scheme-{{ header_scheme_number }}{% if section.settings.overlay %} header--overlay{% endif %}">
  <div class="header__title">
    <a href="{{ routes.root_url }}" class="header__logo-link">
      {% assign active_logo = settings.logo %}
      {% if section.settings.overlay and settings.logo_transparent != blank %}
        {% assign active_logo = settings.logo_transparent %}
      {% endif %}

      {% if active_logo != blank %}
        {{ active_logo | image_url: width: 800 | image_tag: class: 'header__logo', widths: '80, 120, 160, 240, 320, 480, 640, 800', sizes: 'var(--logo-width)' }}
      {% else %}
        {% if settings.logo_fallback == 'shop.name' or settings.logo_fallback == blank %}
          {{ shop.name }}
        {% else %}
          {{ settings.logo_fallback }}
        {% endif %}
      {% endif %}
    </a>
  </div>

  <div class="header__menu">{% render 'navigation', menu: section.settings.menu, presentation: 'inline', label: 'Main navigation' %}</div>

  <div class="header__icons">
    <button class="btn btn--icon btn--unstyled header__search-trigger" type="button" data-overlay-open="#search-drawer" aria-label="{{ 'search.title' | t }}">⌕</button>
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}" aria-label="Account">
        <span class="icon" aria-hidden="true">{{ 'icon-account.svg' | inline_asset_content }}</span>
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}" data-overlay-open="#cart-drawer" aria-label="{{ 'cart.title' | t }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      <span class="icon" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
    </a>
  </div>

  <button class="btn btn--icon btn--unstyled header__menu-trigger" type="button" data-overlay-open="#mobile-navigation" aria-label="Open navigation">☰</button>
  {% render 'search-drawer' %}
  {% render 'cart-drawer' %}
  <dialog id="mobile-navigation" class="drawer mobile-navigation" data-overlay aria-labelledby="mobile-navigation-title">
    <div class="global-search__header"><h2 id="mobile-navigation-title">Menu</h2><button class="btn btn--icon btn--unstyled" type="button" data-overlay-close aria-label="Close navigation">&times;</button></div>
    {% render 'navigation', menu: section.settings.menu, presentation: 'drawer', label: 'Mobile navigation' %}
  </dialog>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header__title { margin: 0; }
  .header__logo {
    display: block;
    width: min(var(--logo-width), 100%);
    height: auto;
  }
  @media screen and (max-width: 749px) {
    .header__logo {
      width: min(var(--logo-width-mobile), 100%);
    }
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--body-color);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header a:focus-visible,
  header shopify-account:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons,
  header .header__social {
    display: flex;
    gap: 1rem;
  }
  .header__menu-trigger { display: none; }
  @media screen and (max-width: 767.98px) {
    .header__menu { display: none; }
    .header__menu-trigger { display: inline-flex; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Enable header overlay",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
