{% liquid
  assign card_product = block.settings.product | default: product
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_image = card_product.featured_image
%}
{% if card_product != blank %}
  <article class="product-card" {{ block.shopify_attributes }}>
    <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {% if card_image != blank %}
        {{ card_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_image.alt | default: card_product.title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </a>
    <div class="product-card__content">
      {% if block.settings.show_vendor and card_product.vendor != blank %}<p class="product-card__vendor">{{ card_product.vendor | escape }}</p>{% endif %}
      <h3 class="card-title-text product-card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      {% render 'price', product: card_product, variant: card_variant, context: 'product_card' %}
      {% if block.settings.show_badge and card_variant.available == false %}<p class="product-card__status">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</p>{% endif %}
      {% if block.settings.show_quick_add and card_variant.available %}
        <a class="btn btn--secondary" href="{{ card_product.url }}">{{ 'products.product.view_options' | t | default: 'View options' }}</a>
      {% endif %}
    </div>
  </article>
{% else %}
  <article class="product-card product-card--empty" {{ block.shopify_attributes }}>{{ 'product-1' | placeholder_svg_tag }}</article>
{% endif %}

{% stylesheet %}
  .product-card { min-width: 0; }
  .product-card__media { background: var(--background-color); display: block; overflow: hidden; }
  .product-card__media img { aspect-ratio: 1 / 1; object-fit: cover; width: 100%; }
  .product-card__content { display: grid; gap: 0.5rem; padding-block: 0.75rem; }
  .product-card__vendor, .product-card__status { font-size: var(--font-body-sm); margin: 0; }
  .product-card__title { margin: 0; }
  .product-card__title a { color: inherit; text-decoration: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Card",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (optional)" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_badge", "label": "Show sold-out badge", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show view options", "default": true }
  ],
  "presets": [{ "name": "Product Card", "category": "Commerce" }]
}
{% endschema %}
