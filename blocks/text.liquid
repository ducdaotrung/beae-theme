{% doc %}
  Renders editorial rich text using the shared Body typography tokens.

  Text owns content and local layout only. It does not expose an HTML tag,
  font family or raw font size control.

  @example
  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{% assign text_content = block.settings.text | default: '' | strip_html | strip %}

{% if text_content != blank %}
  {% assign text_size = block.settings.text_size | default: 'md' %}
  {% assign text_width = block.settings.width | default: 'fit' %}
  {% assign text_alignment = block.settings.alignment | default: 'start' %}
  {% assign text_width_mobile = text_width %}
  {% assign text_alignment_mobile = text_alignment %}
  {% assign text_color = block.settings.text_color | default: 'var(--body-color)' %}

  {% if block.settings.customize_mobile_layout %}
    {% assign text_width_mobile = block.settings.width_mobile | default: text_width %}
    {% if text_width_mobile == 'fill' %}
      {% assign text_alignment_mobile = block.settings.alignment_mobile | default: 'start' %}
    {% endif %}
  {% endif %}

  <div
    class="text-block body-text body-{{ text_size }}{% if text_size == 'custom' %} text-block--custom-size{% endif %}"
    style="
      --text-block-color: {{ text_color }};
      --text-block-custom-size: {{ block.settings.custom_text_size | default: 16 }}px;
      --text-block-width: {% if text_width == 'fill' %}100%{% else %}fit-content{% endif %};
      --text-block-width-mobile: {% if text_width_mobile == 'fill' %}100%{% else %}fit-content{% endif %};
      --text-block-align: {{ text_alignment }};
      --text-block-align-mobile: {{ text_alignment_mobile }};
      --text-block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
      --text-block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
      --text-block-padding-left: {{ block.settings.padding_left | default: 0 }}px;
      --text-block-padding-right: {{ block.settings.padding_right | default: 0 }}px;
      --text-block-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile | default: 0 }}px{% else %}var(--text-block-padding-top){% endif %};
      --text-block-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile | default: 0 }}px{% else %}var(--text-block-padding-bottom){% endif %};
      --text-block-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile | default: 0 }}px{% else %}var(--text-block-padding-left){% endif %};
      --text-block-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile | default: 0 }}px{% else %}var(--text-block-padding-right){% endif %};
      color: {{ text_color }};
      display: block;
      box-sizing: border-box;
      text-align: {{ text_alignment }};
      width: {% if text_width == 'fill' %}100%{% else %}fit-content{% endif %};
      padding: {{ block.settings.padding_top | default: 0 }}px {{ block.settings.padding_right | default: 0 }}px {{ block.settings.padding_bottom | default: 0 }}px {{ block.settings.padding_left | default: 0 }}px;
    "
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text }}
  </div>
{% endif %}

{% stylesheet %}
  .text-block {
    color: var(--text-block-color, var(--body-color));
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    padding-block: var(--text-block-padding-top) var(--text-block-padding-bottom);
    padding-inline: var(--text-block-padding-left) var(--text-block-padding-right);
    text-align: var(--text-block-align);
    width: var(--text-block-width);
  }

  .text-block--custom-size {
    font-size: var(--text-block-custom-size);
    line-height: var(--font-body-line-height);
  }

  .text-block > * {
    color: inherit;
    text-align: inherit;
  }

  .text-block p,
  .text-block ul,
  .text-block ol {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .text-block ul,
  .text-block ol {
    padding-inline-start: 1.5em;
  }

  .text-block a {
    color: inherit;
    text-underline-offset: 0.15em;
  }

  .text-block a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (max-width: 767.98px) {
    .text-block {
      padding-block: var(--text-block-padding-top-mobile) var(--text-block-padding-bottom-mobile);
      padding-inline: var(--text-block-padding-left-mobile) var(--text-block-padding-right-mobile);
      padding-top: var(--text-block-padding-top-mobile) !important;
      padding-right: var(--text-block-padding-right-mobile) !important;
      padding-bottom: var(--text-block-padding-bottom-mobile) !important;
      padding-left: var(--text-block-padding-left-mobile) !important;
      text-align: var(--text-block-align-mobile) !important;
      width: var(--text-block-width-mobile) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Made for everyday moments and rituals.</p>"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "xs", "label": "Extra small" },
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" },
        { "value": "xxl", "label": "2X large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "md"
    },
    {
      "type": "range",
      "id": "custom_text_size",
      "label": "Custom font size",
      "visible_if": "{{ block.settings.text_size == 'custom' }}",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_layout",
      "label": "Customize mobile layout",
      "default": false
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width mobile",
      "visible_if": "{{ block.settings.customize_mobile_layout }}",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Mobile alignment",
      "visible_if": "{{ block.settings.customize_mobile_layout and block.settings.width_mobile == 'fill' }}",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Customize mobile padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "visible_if": "{{ block.settings.customize_mobile_padding }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "visible_if": "{{ block.settings.customize_mobile_padding }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left padding (mobile)",
      "visible_if": "{{ block.settings.customize_mobile_padding }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right padding (mobile)",
      "visible_if": "{{ block.settings.customize_mobile_padding }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Text",
      "category": "Basic"
    }
  ]
}
{% endschema %}
