{% doc %}
  Renders an independent responsive image block.

  Desktop and mobile image behavior are configured independently. A mobile
  image replaces the desktop source on small screens; when it is empty, the
  desktop image remains the fallback source.

  @example
  {% content_for 'block', type: 'image', id: 'image' %}
{% enddoc %}

{% assign image_source = block.settings.image %}

{% if image_source != blank %}
  {% assign mobile_image_source = block.settings.mobile_image | default: image_source %}
  {% assign image_alt = block.settings.alt_text | default: image_source.alt | default: '' %}
  {% assign image_ratio_desktop = block.settings.image_ratio_desktop | default: 'auto' %}
  {% assign image_ratio_mobile = block.settings.image_ratio_mobile | default: 'auto' %}
  {% assign image_width_desktop = block.settings.width_desktop | default: 'fit' %}
  {% assign image_width_mobile = block.settings.width_mobile | default: 'fit' %}

  {% capture desktop_ratio %}
    {% case image_ratio_desktop %}
      {% when 'square' %}1 / 1
      {% when 'portrait' %}3 / 4
      {% when 'landscape' %}4 / 3
      {% when 'wide' %}16 / 9
      {% when 'custom' %}{{ block.settings.image_ratio_custom_desktop | default: 10 | divided_by: 10.0 }}
      {% else %}auto
    {% endcase %}
  {% endcapture %}

  {% capture mobile_ratio %}
    {% case image_ratio_mobile %}
      {% when 'square' %}1 / 1
      {% when 'portrait' %}3 / 4
      {% when 'landscape' %}4 / 3
      {% when 'wide' %}16 / 9
      {% when 'custom' %}{{ block.settings.image_ratio_custom_mobile | default: 10 | divided_by: 10.0 }}
      {% else %}auto
    {% endcase %}
  {% endcapture %}

  {% capture desktop_width %}
    {% case image_width_desktop %}
      {% when 'fill' %}100%
      {% when 'custom' %}{{ block.settings.width_custom_desktop | default: 100 }}%
      {% else %}fit-content
    {% endcase %}
  {% endcapture %}

  {% capture mobile_width %}
    {% case image_width_mobile %}
      {% when 'fill' %}100%
      {% when 'custom' %}{{ block.settings.width_custom_mobile | default: 100 }}%
      {% else %}fit-content
    {% endcase %}
  {% endcapture %}

  <div
    class="image-block"
    data-image-first-mobile="{{ block.settings.show_image_first_mobile }}"
    style="
      --image-block-ratio: {{ desktop_ratio | strip }};
      --image-block-ratio-mobile: {{ mobile_ratio | strip }};
      --image-block-image-height: {% if image_ratio_desktop == 'auto' %}auto{% else %}100%{% endif %};
      --image-block-image-height-mobile: {% if image_ratio_mobile == 'auto' %}auto{% else %}100%{% endif %};
      --image-block-width: {{ desktop_width | strip }};
      --image-block-width-mobile: {{ mobile_width | strip }};
      --image-block-max-width: {% if block.settings.limit_width_desktop %}{{ block.settings.max_width_desktop | default: 1600 }}px{% else %}100%{% endif %};
      --image-block-max-width-mobile: {% if block.settings.limit_width_mobile %}{{ block.settings.max_width_mobile | default: 1600 }}px{% else %}100%{% endif %};
      --image-block-radius: {{ block.settings.corner_radius | default: 0 }}px;
      --image-block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
      --image-block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
      --image-block-padding-left: {{ block.settings.padding_left | default: 0 }}px;
      --image-block-padding-right: {{ block.settings.padding_right | default: 0 }}px;
      --image-block-padding-top-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_top_mobile | default: 0 }}px{% else %}var(--image-block-padding-top){% endif %};
      --image-block-padding-bottom-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_bottom_mobile | default: 0 }}px{% else %}var(--image-block-padding-bottom){% endif %};
      --image-block-padding-left-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_left_mobile | default: 0 }}px{% else %}var(--image-block-padding-left){% endif %};
      --image-block-padding-right-mobile: {% if block.settings.customize_mobile_padding %}{{ block.settings.padding_right_mobile | default: 0 }}px{% else %}var(--image-block-padding-right){% endif %};
    "
    {{ block.shopify_attributes }}
  >
    {% if block.settings.image_link != blank %}
      <a
        class="image-block__link"
        href="{{ block.settings.image_link }}"
        {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
    {% endif %}

    <picture class="image-block__media">
      {% if block.settings.mobile_image != blank %}
        <source media="(max-width: 767.98px)" srcset="{{ mobile_image_source | image_url: width: 2400 }}">
      {% endif %}
      <img
        src="{{ image_source | image_url: width: 2400 }}"
        alt="{{ image_alt | escape }}"
        loading="lazy"
        decoding="async"
        width="{{ image_source.width }}"
        height="{{ image_source.height }}"
      >
    </picture>

    {% if block.settings.image_link != blank %}</a>{% endif %}
  </div>
{% else %}
  <div class="image-block image-block--empty" {{ block.shopify_attributes }}>
    {{ 'image' | placeholder_svg_tag: 'image-block__placeholder' }}
  </div>
{% endif %}

{% stylesheet %}
  .image-block {
    max-width: var(--image-block-max-width);
    min-width: 0;
    padding-block: var(--image-block-padding-top) var(--image-block-padding-bottom);
    padding-inline: var(--image-block-padding-left) var(--image-block-padding-right);
    width: var(--image-block-width);
  }

  .image-block__link,
  .image-block__media {
    display: block;
    max-width: 100%;
    min-width: 0;
  }

  .image-block__media {
    aspect-ratio: var(--image-block-ratio);
    border-radius: var(--image-block-radius);
    overflow: hidden;
    width: 100%;
  }

  .image-block__media img,
  .image-block__placeholder {
    display: block;
    height: var(--image-block-image-height);
    max-width: 100%;
    object-fit: cover;
    width: 100%;
  }

  .image-block__placeholder {
    aspect-ratio: var(--image-block-ratio);
    background: var(--background-color);
    height: 100%;
    min-height: 8rem;
  }

  .image-block--empty {
    width: var(--image-block-width);
  }

  @media screen and (max-width: 767.98px) {
    .image-block {
      max-width: var(--image-block-max-width-mobile);
      padding-block: var(--image-block-padding-top-mobile) var(--image-block-padding-bottom-mobile);
      padding-inline: var(--image-block-padding-left-mobile) var(--image-block-padding-right-mobile);
      width: var(--image-block-width-mobile);
    }

    .image-block__media {
      aspect-ratio: var(--image-block-ratio-mobile);
    }

    .image-block__media img,
    .image-block__placeholder {
      height: var(--image-block-image-height-mobile);
    }

    .image-block__placeholder {
      aspect-ratio: var(--image-block-ratio-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "checkbox",
      "id": "show_image_first_mobile",
      "label": "Show image first on mobile",
      "default": false
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text",
      "info": "Leave blank to use the image alt text. Leave blank for decorative images."
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "Image ratio",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "wide", "label": "Wide" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "image_ratio_custom_desktop",
      "label": "Custom image ratio (×10)",
      "visible_if": "{{ block.settings.image_ratio_desktop == 'custom' }}",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "width_desktop",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom_desktop",
      "label": "Custom width",
      "visible_if": "{{ block.settings.width_desktop == 'custom' }}",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "limit_width_desktop",
      "label": "Limit width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width_desktop",
      "label": "Max width",
      "visible_if": "{{ block.settings.limit_width_desktop }}",
      "min": 0,
      "max": 1600,
      "step": 16,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Image ratio",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "wide", "label": "Wide" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "image_ratio_custom_mobile",
      "label": "Custom image ratio (×10)",
      "visible_if": "{{ block.settings.image_ratio_mobile == 'custom' }}",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "Custom width",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "limit_width_mobile",
      "label": "Limit width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "label": "Max width",
      "visible_if": "{{ block.settings.limit_width_mobile }}",
      "min": 0,
