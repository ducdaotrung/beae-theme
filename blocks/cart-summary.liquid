{% assign summary_cart = cart %}
<aside class="cart-summary-block" {{ block.shopify_attributes }} aria-labelledby="CartSummaryTitle-{{ block.id }}">
  <h2 id="CartSummaryTitle-{{ block.id }}">{{ block.settings.heading | default: 'Order summary' | escape }}</h2>
  {% if summary_cart.item_count == 0 %}
    <p>{{ 'cart.empty' | t }}</p>
  {% else %}
    <dl class="cart-summary-block__totals">
      <div><dt>{{ block.settings.subtotal_label | default: 'Subtotal' }}</dt><dd>{{ summary_cart.items_subtotal_price | money }}</dd></div>
      {% if summary_cart.total_discounts > 0 %}<div><dt>{{ block.settings.discount_label | default: 'Discounts' }}</dt><dd>-{{ summary_cart.total_discounts | money }}</dd></div>{% endif %}
      <div><dt><strong>{{ block.settings.total_label | default: 'Total' }}</strong></dt><dd><strong>{{ summary_cart.total_price | money }}</strong></dd></div>
    </dl>
    <p>{{ block.settings.shipping_note | default: 'Taxes and shipping calculated at checkout.' }}</p>
    <button class="btn btn--primary" type="submit" name="checkout" form="CartForm">{{ 'cart.checkout' | t }}</button>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Cart Summary",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order summary" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "discount_label", "label": "Discount label", "default": "Discounts" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Taxes and shipping calculated at checkout." }
  ],
  "presets": [{ "name": "Cart Summary", "category": "Commerce" }]
}
{% endschema %}
