[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo & Favicons",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_transparent",
        "label": "Transparent logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 20,
        "max": 400,
        "step": 4,
        "unit": "px",
        "label": "Logo width (desktop)",
        "default": 140
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 20,
        "max": 240,
        "step": 4,
        "unit": "px",
        "label": "Logo width (mobile)",
        "default": 120
      },
      {
        "type": "text",
        "id": "logo_fallback",
        "label": "Fallback",
        "default": "shop.name",
        "info": "Used when no logo image is selected."
      }
    ]
  },
